# =============================================================================
# .env.example — copy to .env and fill in real values for local runs.
#
# NOTE: In Docker Compose, prefer compose `environment` or an `env_file`.
#       Do NOT bake secrets into images.
# =============================================================================

# -----------------------------------------------------------------------------
# API (BE)
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
POLL_INTERVAL_MS=15000

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
# On a Compose network, use service name "db" (Docker DNS).
# For local-without-Docker, set DB_HOST=localhost and expose Postgres on 5432.
DB_HOST=db
DB_PORT=5432
DB_USER=notes
DB_PASSWORD=change_me
DB_NAME=notesdb

# Postgres container initialization (used by the `db` service)
POSTGRES_USER=notes
POSTGRES_PASSWORD=change_me
POSTGRES_NAME=notesdb

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# On a Compose network, use service name "cache" (Docker DNS).
# For local-without-Docker, set REDIS_HOST=localhost.
REDIS_HOST=redis
REDIS_PORT=6379
