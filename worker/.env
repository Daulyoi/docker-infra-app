# Copy to .env for local runs. In Docker Compose, prefer compose `environment`
# or an env_file — do not bake secrets into images.

# Postgres — use service name "db" on a Compose network (Docker DNS).
# For local-without-Docker, set DB_HOST=localhost and expose Postgres on 5432.
DB_HOST=db
DB_PORT=5432
DB_USER=notes
DB_PASSWORD=notespass
DB_NAME=notesdb

# Redis — use service name "cache" on a Compose network.
# For local-without-Docker, set REDIS_HOST=localhost.
REDIS_HOST=cache
REDIS_PORT=6379
